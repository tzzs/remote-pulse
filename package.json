{
  "name": "remote-pulse",
  "displayName": "Remote Pulse",
  "description": "%extension.description%",
  "version": "0.2.0",
  "publisher": "tanzz",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "remote-ssh",
    "monitor",
    "status bar",
    "cpu",
    "gpu",
    "docker"
  ],
  "icon": "images/icon.png",
  "l10n": "./l10n",
  "repository": {
    "type": "git",
    "url": "https://github.com/tzzs/remote-pulse.git"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "remotePulse.showTrend",
        "title": "%command.showTrend.title%",
        "category": "Remote Pulse"
      },
      {
        "command": "remotePulse.refresh",
        "title": "%command.refresh.title%",
        "category": "Remote Pulse"
      },
      {
        "command": "remotePulse.showLogs",
        "title": "%command.showLogs.title%",
        "category": "Remote Pulse"
      },
      {
        "command": "remotePulse.configureStatusBarMetrics",
        "title": "%command.configureStatusBarMetrics.title%",
        "category": "Remote Pulse"
      },
      {
        "command": "remotePulse.configureTrendPanelSections",
        "title": "%command.configureTrendPanelSections.title%",
        "category": "Remote Pulse"
      },
      {
        "command": "remotePulse.configureTrendChartMetrics",
        "title": "%command.configureTrendChartMetrics.title%",
        "category": "Remote Pulse"
      },
      {
        "command": "remotePulse.configureNotificationMetrics",
        "title": "%command.configureNotificationMetrics.title%",
        "category": "Remote Pulse"
      }
    ],
    "configuration": {
      "title": "Remote Pulse",
      "properties": {
        "remotePulse.refreshInterval": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "description": "%config.refreshInterval.description%"
        },
        "remotePulse.backgroundInterval": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "description": "%config.backgroundInterval.description%"
        },
        "remotePulse.heavyMetricInterval": {
          "type": "number",
          "default": 10000,
          "minimum": 2000,
          "description": "%config.heavyMetricInterval.description%"
        },
        "remotePulse.warningThreshold": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "maximum": 100,
          "description": "%config.warningThreshold.description%"
        },
        "remotePulse.criticalThreshold": {
          "type": "number",
          "default": 95,
          "minimum": 1,
          "maximum": 100,
          "description": "%config.criticalThreshold.description%"
        },
        "remotePulse.gpuTempWarningThreshold": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "maximum": 150,
          "description": "%config.gpuTempWarningThreshold.description%"
        },
        "remotePulse.gpuTempCriticalThreshold": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "maximum": 150,
          "description": "%config.gpuTempCriticalThreshold.description%"
        },
        "remotePulse.statusBarMetrics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cpu",
              "memory",
              "gpu",
              "network"
            ],
            "enumDescriptions": [
              "%config.statusBarMetrics.cpu.description%",
              "%config.statusBarMetrics.memory.description%",
              "%config.statusBarMetrics.gpu.description%",
              "%config.statusBarMetrics.network.description%"
            ]
          },
          "uniqueItems": true,
          "default": [
            "cpu",
            "memory"
          ],
          "description": "%config.statusBarMetrics.description%",
          "markdownDescription": "%config.statusBarMetrics.markdownDescription%"
        },
        "remotePulse.statusBarAlignment": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "enumDescriptions": [
            "%config.statusBarAlignment.left.description%",
            "%config.statusBarAlignment.right.description%"
          ],
          "default": "left",
          "description": "%config.statusBarAlignment.description%"
        },
        "remotePulse.trendPanelSections": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "network",
              "diskIo",
              "gpu",
              "processes",
              "docker"
            ],
            "enumDescriptions": [
              "%config.trendPanelSections.network.description%",
              "%config.trendPanelSections.diskIo.description%",
              "%config.trendPanelSections.gpu.description%",
              "%config.trendPanelSections.processes.description%",
              "%config.trendPanelSections.docker.description%"
            ]
          },
          "uniqueItems": true,
          "default": [
            "gpu",
            "docker"
          ],
          "description": "%config.trendPanelSections.description%",
          "markdownDescription": "%config.trendPanelSections.markdownDescription%"
        },
        "remotePulse.trendChartMetrics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cpu",
              "memory",
              "gpu",
              "network"
            ],
            "enumDescriptions": [
              "%config.trendChartMetrics.cpu.description%",
              "%config.trendChartMetrics.memory.description%",
              "%config.trendChartMetrics.gpu.description%",
              "%config.trendChartMetrics.network.description%"
            ]
          },
          "uniqueItems": true,
          "default": [
            "cpu",
            "memory"
          ],
          "description": "%config.trendChartMetrics.description%",
          "markdownDescription": "%config.trendChartMetrics.markdownDescription%"
        },
        "remotePulse.trendWindowMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 240,
          "description": "%config.trendWindowMinutes.description%"
        },
        "remotePulse.notificationMetrics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cpu",
              "memory",
              "disk",
              "gpu"
            ],
            "enumDescriptions": [
              "%config.notificationMetrics.cpu.description%",
              "%config.notificationMetrics.memory.description%",
              "%config.notificationMetrics.disk.description%",
              "%config.notificationMetrics.gpu.description%"
            ]
          },
          "uniqueItems": true,
          "default": [
            "cpu",
            "memory",
            "disk"
          ],
          "description": "%config.notificationMetrics.description%",
          "markdownDescription": "%config.notificationMetrics.markdownDescription%"
        },
        "remotePulse.enableNotifications": {
          "type": "boolean",
          "default": false,
          "description": "%config.enableNotifications.description%"
        },
        "remotePulse.diskMountPoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.diskMountPoints.description%"
        },
        "remotePulse.networkInterfaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.networkInterfaces.description%"
        },
        "remotePulse.gpuSelection": {
          "type": "string",
          "enum": [
            "primary",
            "busiest"
          ],
          "enumDescriptions": [
            "%config.gpuSelection.primary.description%",
            "%config.gpuSelection.busiest.description%"
          ],
          "default": "primary",
          "description": "%config.gpuSelection.description%"
        },
        "remotePulse.topProcessCount": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 30,
          "description": "%config.topProcessCount.description%"
        },
        "remotePulse.dockerMaxContainers": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 200,
          "description": "%config.dockerMaxContainers.description%"
        },
        "remotePulse.cgroupAware": {
          "type": "boolean",
          "default": true,
          "description": "%config.cgroupAware.description%",
          "markdownDescription": "%config.cgroupAware.markdownDescription%"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "remotePulse.showTrend",
          "when": "remotePulse.active"
        },
        {
          "command": "remotePulse.refresh",
          "when": "remotePulse.active"
        },
        {
          "command": "remotePulse.showLogs",
          "when": "remotePulse.active"
        },
        {
          "command": "remotePulse.configureStatusBarMetrics",
          "when": "remotePulse.active"
        },
        {
          "command": "remotePulse.configureTrendPanelSections",
          "when": "remotePulse.active"
        },
        {
          "command": "remotePulse.configureTrendChartMetrics",
          "when": "remotePulse.active"
        },
        {
          "command": "remotePulse.configureNotificationMetrics",
          "when": "remotePulse.active"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "compile:tests": "tsc -p ./test/tsconfig.test.json",
    "pretest": "npm run build && npm run compile:tests",
    "test": "node --test out-test/test/*.test.js test/*.test.mjs",
    "pretest:integration": "npm run build && npm run compile:tests",
    "test:integration": "vscode-test",
    "package": "vsce package",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.13.0",
    "mocha": "^12.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.12.0"
  }
}
