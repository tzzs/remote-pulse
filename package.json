{
  "name": "remote-pulse",
  "displayName": "Remote Pulse",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "tanzz",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["remote-ssh", "monitor", "status bar", "cpu", "gpu", "docker"],
  "icon": "images/icon.png",
  "l10n": "./l10n",
  "repository": {
    "type": "git",
    "url": "https://github.com/tzzs/remote-pulse.git"
  },
  "extensionKind": ["workspace"],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "remotePulse.showTrend",
        "title": "%command.showTrend.title%",
        "category": "Remote Pulse"
      },
      {
        "command": "remotePulse.refresh",
        "title": "%command.refresh.title%",
        "category": "Remote Pulse"
      }
    ],
    "configuration": {
      "title": "Remote Pulse",
      "properties": {
        "remotePulse.refreshInterval": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "description": "%config.refreshInterval.description%"
        },
        "remotePulse.backgroundInterval": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "description": "%config.backgroundInterval.description%"
        },
        "remotePulse.heavyMetricInterval": {
          "type": "number",
          "default": 10000,
          "minimum": 2000,
          "description": "%config.heavyMetricInterval.description%"
        },
        "remotePulse.statusBarMetric": {
          "type": "string",
          "enum": ["cpu", "memory"],
          "default": "cpu",
          "description": "%config.statusBarMetric.description%"
        },
        "remotePulse.warningThreshold": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "maximum": 100,
          "description": "%config.warningThreshold.description%"
        },
        "remotePulse.criticalThreshold": {
          "type": "number",
          "default": 95,
          "minimum": 1,
          "maximum": 100,
          "description": "%config.criticalThreshold.description%"
        },
        "remotePulse.template": {
          "type": "string",
          "default": "$(pulse) ${value}%",
          "description": "%config.template.description%"
        },
        "remotePulse.enableGpu": {
          "type": "boolean",
          "default": true,
          "description": "%config.enableGpu.description%"
        },
        "remotePulse.enableDocker": {
          "type": "boolean",
          "default": true,
          "description": "%config.enableDocker.description%"
        },
        "remotePulse.enableNetwork": {
          "type": "boolean",
          "default": false,
          "description": "%config.enableNetwork.description%"
        },
        "remotePulse.enableNotifications": {
          "type": "boolean",
          "default": false,
          "description": "%config.enableNotifications.description%"
        },
        "remotePulse.diskMountPoints": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "%config.diskMountPoints.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run build && tsc -p ./test/tsconfig.test.json",
    "test": "node --test out-test/test/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.5.4",
    "@vscode/vsce": "^3.0.0"
  }
}
